---
import fs from "node:fs/promises";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const docsDir = "docs";
  const entries = await fs.readdir(docsDir, { withFileTypes: true });
  const galleries = entries
    .filter((e) => e.isDirectory() && !e.name.startsWith("."))
    .map((e) => e.name);

  return galleries.map((gallery) => ({
    params: { gallery },
  }));
}

const { gallery } = Astro.params;

const allDocs = import.meta.glob("../../../docs/**/index.{md,mdx}", {
  eager: true,
});
const docKey = Object.keys(allDocs).find((k) =>
  k.includes(`/docs/${gallery}/index.`),
);
const doc = docKey ? (allDocs[docKey] as any) : null;
const Content = doc ? doc.Content : null;
const frontmatter = doc ? doc.frontmatter : {};
const title =
  frontmatter.title ||
  gallery
    .split("-")
    .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");

// Detect whether the gallery folder has any images even though it has no
// index.mdx yet. This lets us render a helpful "preparing" state instead of
// a silent blank page while the author hasn't run `npm run process`.
let hasPendingPhotos = false;
if (!Content) {
  try {
    const files = await fs.readdir(path.join(process.cwd(), "docs", gallery));
    hasPendingPhotos = files.some(
      (f) =>
        /\.(jpe?g|png|webp|gif|tiff?|heic)$/i.test(f) &&
        !/_lq\.jpe?g$/i.test(f),
    );
    if (!hasPendingPhotos) {
      console.warn(
        `[gallery/${gallery}] No index.mdx and no source photos in docs/${gallery}`,
      );
    }
  } catch (_e) {
    console.warn(
      `[gallery/${gallery}] Directory not readable: docs/${gallery}`,
    );
  }
}
---

<Layout title={`${title} | Alexander Gu`}>
  <div class="mb-24">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-900 border-b border-transparent hover:border-zinc-900 pb-1 uppercase tracking-[0.2em] text-[10px] font-black transition-all dark:hover:text-zinc-100 dark:hover:border-zinc-100 no-underline"
      >&larr; Back to selection</a
    >
    <div class="max-w-4xl">
      <h1
        class="text-6xl md:text-8xl font-black mt-12 mb-6 uppercase tracking-tight leading-[0.85] text-zinc-900 dark:text-zinc-50"
        style="font-family: 'Saira Variable', sans-serif"
      >
        {title}
      </h1>
      {
        frontmatter.date && (
          <p class="text-zinc-400 font-bold tracking-[0.3em] uppercase text-[10px]">
            {new Date(frontmatter.date).toLocaleDateString("en-US", {
              month: "long",
              year: "numeric",
            })}
          </p>
        )
      }
    </div>
  </div>

  {
    Content && (
      <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-900 dark:text-zinc-50 mt-32">
        <Content components={{ h1: () => null }} />
      </div>
    )
  }

  {
    !Content && (
      <div class="mt-32 p-16 rounded-3xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-zinc-100/30 dark:bg-zinc-900/10 text-center">
        <p class="text-zinc-400 dark:text-zinc-500 font-bold tracking-[0.3em] uppercase text-[10px]">
          {hasPendingPhotos ? "Gallery is being prepared" : "No photos yet"}
        </p>
        <p class="mt-6 text-zinc-500 dark:text-zinc-400 text-sm leading-relaxed max-w-md mx-auto">
          {hasPendingPhotos
            ? "Photos are waiting to be processed. Run `npm run process` to generate the gallery."
            : "This series doesn't have an index yet."}
        </p>
      </div>
    )
  }
</Layout>
