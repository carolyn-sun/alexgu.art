---
import Layout from "../layouts/Layout.astro";
import Flow from "../components/Flow.tsx";
import fs from "node:fs/promises";
import path from "node:path";

const allDocs = import.meta.glob("../../docs/**/index.{md,mdx}", {
  eager: true,
});
const galleries = await Promise.all(
  Object.entries(allDocs).map(async ([mdxKey, doc]: [string, any]) => {
    const gallery = mdxKey.split("/").slice(-2, -1)[0];
    const title =
      doc.frontmatter.title ||
      gallery
        .split("-")
        .map((w: string) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");

    // Find first photo for cover
    let coverUrl = null;
    try {
      const absMdxPath = path.join(
        process.cwd(),
        "docs",
        gallery,
        mdxKey.endsWith(".md") ? "index.md" : "index.mdx",
      );
      const content = await fs.readFile(absMdxPath, "utf-8");

      const photoMatch = content.match(/<Photo.*?json={(\w+)}/);
      if (photoMatch) {
        const varName = photoMatch[1];
        const importRegex = new RegExp(
          `import\\s+${varName}\\s+from\\s+["'](.*?\\.json)["']`,
        );
        const importMatch = content.match(importRegex);
        if (importMatch) {
          const jsonFileName = importMatch[1];
          const baseName = path.basename(jsonFileName, ".json");
          coverUrl = `/docs/${gallery}/${baseName}_lq.jpeg`;
        }
      }

      // Fallback: first json in folder
      if (!coverUrl) {
        const files = await fs.readdir(
          path.join(process.cwd(), "docs", gallery),
        );
        const firstJson = files
          .sort()
          .find((f) => f.endsWith(".json") && f !== "package.json");
        if (firstJson) {
          const baseName = path.basename(firstJson, ".json");
          coverUrl = `/docs/${gallery}/${baseName}_lq.jpeg`;
        }
      }
    } catch (e) {}

    return { gallery, title, coverUrl };
  }),
);
---

<Layout title="Alexander Gu | Photography">
  <div class="mb-32">
    <Flow client:load />
    <div
      class="mt-20 bg-zinc-100/30 dark:bg-zinc-900/10 border border-zinc-200/50 dark:border-zinc-800/50 rounded-3xl p-10 md:p-16 text-center backdrop-blur-sm"
    >
      <h2
        class="text-3xl font-black tracking-tight mb-6 uppercase text-zinc-900 dark:text-zinc-50"
        style="font-family: 'Saira Variable'"
      >
        Guide to the Gallery
      </h2>
      <p
        class="text-zinc-500 dark:text-zinc-400 font-medium max-w-2xl mx-auto leading-relaxed text-lg"
      >
        To optimize the browsing experience, photos are loaded as low-resolution
        thumbnails by default.
        <br />
        <strong
          class="text-zinc-900 dark:text-zinc-100 font-black mt-4 inline-block tracking-wide uppercase text-sm"
          >Click any photo for full resolution.</strong
        >
      </p>
      <div class="mt-8 flex flex-col items-center gap-2">
        <span class="text-zinc-300 dark:text-zinc-700 font-black text-2xl"
          >...</span
        >
        <a
          href="/me"
          class="inline-block tracking-[0.4em] text-[10px] font-black uppercase hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors border-b-2 border-transparent hover:border-current pb-1"
          >Alexander Gu</a
        >
      </div>
    </div>
  </div>

  <div class="flex items-center gap-6 mb-16 overflow-hidden">
    <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1"></div>
    <h3
      class="text-[10px] font-black tracking-[0.6em] uppercase text-zinc-400 dark:text-zinc-600"
      style="font-family: 'Montserrat Variable'"
    >
      Selected Series
    </h3>
    <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16">
    {
      galleries.map(({ gallery, title, coverUrl }) => (
        <a
          href={`/${gallery}`}
          class="group relative block aspect-[16/10] overflow-hidden rounded-3xl bg-zinc-100 dark:bg-zinc-900 shadow-2xl transition-all duration-700 hover:-translate-y-2 border border-black/5 dark:border-white/5"
        >
          <div class="absolute inset-0 z-0">
            {coverUrl && (
              <img
                src={coverUrl}
                alt={title}
                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 group-hover:blur-[2px]"
                loading="lazy"
              />
            )}
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent z-10 opacity-70 group-hover:opacity-90 transition-opacity duration-700" />
          <div class="absolute inset-x-0 bottom-0 z-20 p-10 flex flex-col justify-end h-full">
            <h2
              class="text-3xl md:text-5xl font-black text-white tracking-tight uppercase mb-2 leading-none"
              style="font-family: 'Saira Variable'"
            >
              {title}
            </h2>
            <div class="flex items-center gap-3 text-zinc-400 text-[10px] tracking-[0.3em] uppercase font-black opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-700 ease-out">
              <span>Explore Series</span>
              <div class="w-12 h-px bg-current" />
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Layout>
