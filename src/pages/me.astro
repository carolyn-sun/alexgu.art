---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Alexander Gu | About">
  <div class="max-w-3xl mx-auto py-12">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-900 border-b border-transparent hover:border-zinc-900 pb-1 uppercase tracking-[0.2em] text-[10px] font-black transition-all dark:hover:text-zinc-100 dark:hover:border-zinc-100 no-underline mb-12"
      >&larr; Back to Selection</a
    >

    <div class="prose prose-zinc dark:prose-invert max-w-none">
      <h1
        class="text-6xl md:text-8xl font-black mb-16 uppercase tracking-tight leading-[0.85] text-zinc-900 dark:text-zinc-50"
        style="font-family: 'Saira Variable', sans-serif"
      >
        About
      </h1>

      <div class="flex flex-col md:flex-row items-start gap-12 mb-20">
        <img
          src="/img/avatar.jpg"
          alt="Alexander Gu"
          class="w-32 h-32 rounded-3xl object-cover shadow-2xl border border-white/10"
        />
        <div class="flex-1">
          <h2
            class="text-3xl font-black tracking-tight uppercase mb-4"
            style="font-family: 'Saira Variable'"
          >
            Alexander Gu
          </h2>
          <p
            class="text-zinc-500 dark:text-zinc-400 text-lg font-medium leading-relaxed"
          >
            Analog enthusiast and photographer focusing on the tactile nature of <strong
              class="text-zinc-900 dark:text-zinc-100 font-black">film</strong
            >. Explore the transition between light and silver halide.
          </p>
          <div
            class="mt-8 pt-8 border-t border-zinc-100 dark:border-zinc-900/50"
          >
            <span
              class="block uppercase tracking-[0.4em] text-[10px] font-black text-zinc-300 dark:text-zinc-700 mb-2"
              >Connect</span
            >
            <a
              href="mailto:gjc78263@gmail.com"
              class="text-xl font-bold text-zinc-900 dark:text-zinc-100 hover:opacity-60 transition-opacity"
              >gjc78263[at]gmail.com</a
            >
          </div>
        </div>
      </div>

      <div class="my-24 h-px bg-zinc-200 dark:bg-zinc-900/50"></div>

      <div class="space-y-24">
        <section>
          <h2
            class="text-sm font-black tracking-[0.4em] uppercase text-zinc-300 dark:text-zinc-700 mb-8"
          >
            Concept
          </h2>
          <p
            class="text-xl md:text-2xl font-medium leading-relaxed max-w-2xl text-zinc-800 dark:text-zinc-200"
          >
            This digital archive serves as a repository for personal creative
            works, documenting the intersection of modern vision and traditional
            craft.
          </p>
        </section>

        <section>
          <h2
            class="text-sm font-black tracking-[0.4em] uppercase text-zinc-300 dark:text-zinc-700 mb-8"
          >
            Hardware Archive
          </h2>
          <div
            class="overflow-x-auto rounded-3xl border border-zinc-200 dark:border-zinc-800/50 bg-zinc-100/30 dark:bg-zinc-900/10 backdrop-blur-sm shadow-xl"
          >
            <table class="w-full text-left border-collapse m-0">
              <thead>
                <tr
                  class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 dark:text-zinc-600 border-b border-zinc-200 dark:border-zinc-800/50"
                >
                  <th class="py-6 px-8 font-black">Medium / Device</th>
                  <th class="py-6 px-8 font-black text-right"
                    >System Category</th
                  >
                </tr>
              </thead>
              <tbody class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">iPhone 15 Pro</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Digital Capture / Video</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Ricoh GR III</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Digital Compact</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Canon EOS 5D Mk IV</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Digital 135</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Fujifilm GFX100S</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Digital MF</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Nikon F4S</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >135 Format</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">CONTAX G1/G2</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >135 Format</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Konica Genba Kantoku Zoom</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >135 Format</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Fujifilm TX-1</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >135 Panorama</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Pentax 67II</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >120 Format</td
                  >
                </tr>
                <tr
                  class="hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Linhof Technikardan S45</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Large Format</td
                  >
                </tr>
                <tr
                  class="border-b border-zinc-200/50 dark:border-zinc-800/30 hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">DJI Osmo Action 5 Pro</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Video</td
                  >
                </tr>
                <tr
                  class="hover:bg-zinc-200/20 dark:hover:bg-zinc-800/20 transition-colors"
                >
                  <td class="py-6 px-8">Panasonic LUMIX DC-S1M2</td>
                  <td
                    class="py-6 px-8 text-right text-zinc-400 dark:text-zinc-500 font-medium tracking-widest text-[10px] uppercase"
                    >Video</td
                  >
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2
            class="text-sm font-black tracking-[0.4em] uppercase text-zinc-300 dark:text-zinc-700 mb-8"
          >
            Open Source
          </h2>
          <p
            class="text-xl font-medium leading-relaxed text-zinc-800 dark:text-zinc-200"
          >
            The source code for this digital archive is openly available on <a
              href="https://github.com/carolyn-sun/alexgu.art"
              target="_blank"
              rel="noopener"
              class="text-zinc-900 dark:text-zinc-100 underline decoration-zinc-200 dark:decoration-zinc-800 underline-offset-8 hover:decoration-zinc-900 dark:hover:decoration-zinc-100 transition-all font-black"
              >GitHub</a
            >. Feel free to explore the architecture behind this platform.
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
